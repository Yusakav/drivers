	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_sink.dir\build.make CMakeFiles/test_sink.dir/usbpd_protocol.c.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_source.dir\build.make CMakeFiles/test_source.dir/usbpd_protocol.c.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_drp.dir\build.make CMakeFiles/test_drp.dir/usbpd_protocol.c.s
.PHONY : usbpd_protocol.c.s

