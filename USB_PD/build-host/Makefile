	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_protocol.dir\build.make CMakeFiles/test_protocol.dir/usbpd_protocol.c.obj
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_sink.dir\build.make CMakeFiles/test_sink.dir/usbpd_protocol.c.obj
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_source.dir\build.make CMakeFiles/test_source.dir/usbpd_protocol.c.obj
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_drp.dir\build.make CMakeFiles/test_drp.dir/usbpd_protocol.c.obj
.PHONY : usbpd_protocol.c.obj

usbpd_protocol.i: usbpd_protocol.c.i
.PHONY : usbpd_protocol.i

# target to preprocess a source file
usbpd_protocol.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_protocol.dir\build.make CMakeFiles/test_protocol.dir/usbpd_protocol.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_sink.dir\build.make CMakeFiles/test_sink.dir/usbpd_protocol.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_source.dir\build.make CMakeFiles/test_source.dir/usbpd_protocol.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_drp.dir\build.make CMakeFiles/test_drp.dir/usbpd_protocol.c.i
.PHONY : usbpd_protocol.c.i

usbpd_protocol.s: usbpd_protocol.c.s
.PHONY : usbpd_protocol.s

# target to generate assembly for a file
usbpd_protocol.c.s:
